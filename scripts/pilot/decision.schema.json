{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/octolaba/changelog/schemas/review-signal-v1.json",
  "title": "Pilot dependency review signal",
  "description": "One complete immutable owner-review envelope, including every item of a grouped signal. It is stored as decisions/reviews/<reviewId>.json and is never merge authorization by itself. A separate server-captured authoritative update set and the semantic invariants in the specification are not supplied by this schema-valid client body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "recordedAt", "actor", "generation", "idempotencyKey", "pullRequest", "items"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reviewId": {"description": "Immutable envelope identifier and canonical decisions/reviews/<reviewId>.json filename stem.", "type": "string", "format": "uuid"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "generation": {"description": "Proposed next generation in the single store-wide decisions namespace; it must equal the value required by the server under the store lock.", "type": "integer", "minimum": 1},
    "idempotencyKey": {"description": "Store-wide retry key for this exact canonical payload.", "type": "string", "minLength": 8},
    "pullRequest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pullRequest"}]},
    "items": {"description": "The complete item set for this single or grouped review envelope.", "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "moduleEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "version", "revision"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v.+"},
        "revision": {"$ref": "#/$defs/gitRevision"}
      }
    },
    "versionEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["declared", "effective"],
      "properties": {"declared": {"$ref": "#/$defs/moduleEndpoint"}, "effective": {"$ref": "#/$defs/moduleEndpoint"}}
    },
    "consumer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "manifest", "commit", "manifestSha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "manifest": {"enum": ["go.mod", "tools/go.mod"]},
        "commit": {"$ref": "#/$defs/gitRevision"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "updateIdentity": {
      "description": "One direct update in one consumer manifest. Module is the declared module path.",
      "type": "object", "additionalProperties": false,
      "required": ["repository", "manifest", "module"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "manifest": {"enum": ["go.mod", "tools/go.mod"]},
        "module": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "revision", "sha256", "cutoff", "sourceIds"],
      "properties": {
        "path": {"type": "string", "pattern": "^results/.+"},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "cutoff": {"type": "string", "format": "date-time"},
        "sourceIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedUpdates", "reviewedUpdates", "complete"],
      "properties": {
        "expectedUpdates": {"description": "Untrusted client echo; semantic validation must compare it with the separate server-captured authoritative update set.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/updateIdentity"}},
        "reviewedUpdates": {"description": "Untrusted client echo of submitted item identities; semantic validation compares it with both the submitted items and trusted authority.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/updateIdentity"}},
        "complete": {"type": "boolean"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "decision", "reason", "consumer", "from", "to", "analysis", "coverage"],
      "properties": {
        "itemId": {"type": "string", "minLength": 1},
        "decision": {"enum": ["accept", "decline"]},
        "reason": {"type": ["string", "null"]},
        "consumer": {"$ref": "#/$defs/consumer"},
        "from": {"$ref": "#/$defs/versionEndpoint"},
        "to": {"$ref": "#/$defs/versionEndpoint"},
        "analysis": {"$ref": "#/$defs/analysis"},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "pullRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "number", "baseSha", "headSha", "dependencyGroup"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "number": {"type": "integer", "minimum": 1},
        "baseSha": {"$ref": "#/$defs/gitRevision"},
        "headSha": {"$ref": "#/$defs/gitRevision"},
        "dependencyGroup": {"type": ["string", "null"]}
      }
    }
  }
}
